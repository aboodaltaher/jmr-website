# Copy to .env.local for local work; in Vercel set these under Project → Settings → Environment Variables.
# NEXT_PUBLIC_* values are public (they ship in the page's JavaScript) and are read at BUILD time,
# so redeploy after changing them. Leaving a Google Ads value empty falls back to the same IDs
# hard-coded in src/lib/gtag.ts, so tracking never switches off by accident.

# --- Google Ads (account 751-132-8839, currency AED) -------------------------------------------
# Account tag, configured on the site's single gtag.js next to GA4.
NEXT_PUBLIC_GADS_ID=AW-18332305339
# "Quote Form Submit" (count: one) — fired after every SUCCESSFUL lead-form submission.
NEXT_PUBLIC_GADS_QUOTE_CONVERSION=AW-18332305339/T_88CIvtt7sdELuPw6VE
# "Call button clicks – website" — fired on every tel: click, before the dialler opens.
NEXT_PUBLIC_GADS_CALL_CONVERSION=AW-18332305339/jMslCPeI_dIcELuPw6VE
# (The "WhatsApp Click" conversion label is fixed in src/lib/gtag.ts and intentionally not configurable.)

# Enhanced conversions for leads (hashed email/phone sent with the quote conversion). Leave
# "false" until enhanced conversions is turned on in Google Ads AND the privacy wording is
# updated (see docs/tracking.md).
NEXT_PUBLIC_GADS_ENHANCED_CONVERSIONS=false

# --- Optional extras -------------------------------------------------------------------------
# An ADDITIONAL GA4 property only (the main one, G-H7HNVQGSYM, is built in). Leave empty.
NEXT_PUBLIC_GA_ID=
# Google Tag Manager container. Leave empty unless you use GTM (don't duplicate GA4/Ads in it).
NEXT_PUBLIC_GTM_ID=

# --- Server-side (secrets: set in Vercel only, never commit real values) ----------------------
# RESEND_API_KEY=
# CONTACT_EMAIL=
# RESEND_FROM=
# CONTACT_EMAIL_BACKUP=
